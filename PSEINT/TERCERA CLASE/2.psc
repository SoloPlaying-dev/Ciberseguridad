Algoritmo sin_titulo
	Definir num Como Entero
    Escribir "Ingrese un número: "
    Leer num
    Si num > 0 Entonces
        Escribir "El número es positivo"
    Sino
        Si num < 0 Entonces
            Escribir "El número es negativo"
        Sino
            Escribir "El número es cero"
        FinSi
    FinSi
FinAlgoritmo
