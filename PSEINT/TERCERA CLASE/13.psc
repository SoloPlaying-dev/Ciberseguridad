Algoritmo sin_titulo
	Definir n, i, fact Como Entero
    fact <- 1
    Escribir "Ingrese un número: "
    Leer n
    Para i <- 1 Hasta n Con Paso 1 Hacer
        fact <- fact * i
    FinPara
    Escribir "El factorial es: ", fact
FinAlgoritmo
