Algoritmo sin_titulo
	Definir i, num, suma Como Entero
    suma <- 0
    Para i <- 1 Hasta 10 Con Paso 1 Hacer
        Escribir "Ingrese un número: "
        Leer num
        suma <- suma + num
    FinPara
    Escribir "La suma total es: ", suma
FinAlgoritmo
